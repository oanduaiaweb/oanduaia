{
  "name": "oanduaia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-i18n.mjs && node --no-warnings --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-facts.mjs && node --no-warnings --experimental-strip-types scripts/test-locale.mjs && next build",
    "start": "next start",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:locale": "node --no-warnings --experimental-strip-types scripts/test-locale.mjs",
    "bookings": "node scripts/bookings.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "leaflet": "^1.9.4",
    "next": "^16.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.10.0",
    "stripe": "^22.6.1"
  },
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
