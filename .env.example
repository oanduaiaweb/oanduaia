# Enquiry form (Resend) — set in Vercel, not needed for local design work.
RESEND_API_KEY=

# Availability calendar.
#
# One Booking.com iCal export link per house. Extranet → Calendar → Sync calendars →
# Export calendar, taken separately for each of the three room types. Booking.com only
# offers this while the property has no channel manager / XML connection and no more than
# 20 room types with a single unit each — which is the case here.
#
# Missing or unreachable feeds are NOT read as "everything is free": the calendar says so
# and the enquiry still goes through. Several feeds for one house can be comma-separated.
# Only Saunamaja and Metsamaja are listed on Booking.com — Tiigimaja is not, so its
# variable stays empty and its calendar is ours alone.
ICAL_SAUNAMAJA=
ICAL_TIIGIMAJA=
ICAL_METSAMAJA=

# Availability admin at /admin — one operator, so a password rather than accounts.
# Both must be set or the admin refuses every login: an unconfigured deployment has no
# admin rather than an open one. ADMIN_SECRET signs the session cookie; make it long
# and random (e.g. `openssl rand -base64 32`).
ADMIN_PASSWORD=
ADMIN_SECRET=

# Publishes our own calendar at /api/ical/<house>.ics?t=<token>, for Booking.com and
# others to IMPORT. Unset means the route 404s — the feed is never open. Both
# /api/ical/saunamaja and /api/ical/saunamaja.ics work.
#
# Do NOT store this one as "Sensitive" in Vercel. Sensitive values are write-only: the
# first one was, which made the feed URL impossible for anyone to reconstruct, including
# the person who has to paste it into Booking.com.
ICAL_EXPORT_TOKEN=
